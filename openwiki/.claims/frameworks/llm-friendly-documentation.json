  "claims": [
    {
      "id": "claim_67351b60f066404b830cf86ee6e0349d",
      "statement": "The framework's core statement is that a document is easy for an LLM to read when the structure, relationships, and conditions of its information are written explicitly enough that the LLM never has to reconstruct them by inference.",
      "evidence": [
        {
          "resource": "repo://agent-expertise-framework/00-data-lake/00-llm-friendly-docs-framework.md#L8-L10",
          "version": "repo-lines-v1:sha256:cdc101f880905948fb493759695497f9f95d1ae16c07bf60e1eb0d3e25491b97:"
        }
      ]
    },
    {
      "id": "claim_df93dbfb1e694291a424727a165583b3",
      "statement": "The framework consists of 12 principles: explicitness; writing why not just what; separating current vs target state; a glossary with explicitly excluded terms; describing file structure as responsibility rather than listing; making prohibitions explicit as Constraints; precise numeric conditions; explicit code-doc-DB-cache relationships; splitting documentation by topic instead of one giant document; ADRs; a PROJECT-to-CODE document hierarchy; and a verification system as the final and most critical principle.",
      "evidence": [
        {
          "resource": "repo://agent-expertise-framework/00-data-lake/00-llm-friendly-docs-framework.md#L12-L67",
          "version": "repo-lines-v1:sha256:f24c2af5a90cbba43fc41c1d7179e43467ce4ad0aeafa6797e658b5ef92523ac:"
        }
      ]
    },
    {
      "id": "claim_5ae24fedde594534bcf546682bdc3ff5",
      "statement": "Principle 12 argues documentation alone is insufficient; an agent must be forced through a verification loop (search docs, search code, confirm current implementation, check doc/code agreement, report on mismatch instead of modifying, plan, modify, test, re-verify) before and after making changes.",
      "evidence": [
        {
          "resource": "repo://agent-expertise-framework/00-data-lake/00-llm-friendly-docs-framework.md#L59-L67",
          "version": "repo-lines-v1:sha256:fa94afe5b713ab5c8e450f677db6274c45aac71e031ec43127909d4d35fc3cb0:"
        }
      ]
    },
    {
      "id": "claim_41026ab4e45146e1a4bc9bac3157ee8b",
      "statement": "The framework states that documentation is the knowledge that tells an LLM about the project, while the verification system is the mechanism that prevents the LLM from freely inventing that knowledge, and that this is the core mechanism for suppressing hallucination in large projects.",
      "evidence": [
        {
          "resource": "repo://agent-expertise-framework/00-data-lake/00-llm-friendly-docs-framework.md#L69-L69",
          "version": "repo-lines-v1:sha256:2c54da94f2ec7854d154fb6883cf7deb3e2acafc3b8cbc501f78766f9f96ba68:"
        }
      ]
    }
  ],
